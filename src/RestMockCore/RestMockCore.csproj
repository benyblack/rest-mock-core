<Project Sdk="Microsoft.NET.Sdk ">

  <PropertyGroup>
    <Description>A simple http server for using as a mock in test projects</Description>
    <AssemblyTitle>rest-mock-core</AssemblyTitle>
    <Authors>Behnam Yousefi</Authors>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>RestMockCore</AssemblyName>
    <PackageId>rest-mock-core</PackageId>
    <PackageTags>c#;dotnet;aspnetcore;unit-testing;xunit;mock;</PackageTags>
    <PackageReleaseNotes>Multi-target net8.0 + net10.0; add VerificationException; bug fixes</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/benyblack/rest-mock-core</RepositoryUrl>
    <PackageProjectUrl>https://github.com/benyblack/rest-mock-core</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.9.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>